# Private credentials for the native Stable Audio sidecar and worker-music only.
# Copy this file to .env.music; it is gitignored. Generate each value with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MUSIC_SERVICE_TOKEN=
MUSIC_SERVICE_HMAC_SECRET=

# These two settings are used only by the native macOS service. Docker workers
# can receive them harmlessly but never execute the MLX binary or read its data.
MUSIC_SERVICE_SA3_PATH=/Users/YOU/src/stable-audio-3/optimized/mlx/sa3
MUSIC_SERVICE_DATA_DIR=/Users/YOU/.local/share/daastaan-music
# Completed / failed temporary jobs are removed after this many seconds if the
# central worker did not already delete them after durable upload.
MUSIC_SERVICE_OUTPUT_RETENTION_SECONDS=3600
