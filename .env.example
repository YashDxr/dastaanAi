# Copy to .env and fill in. Never commit .env - it is gitignored.
#
# Hostnames below are the Docker Compose service names. If you run the API or a
# worker directly on your laptop instead of in Compose, swap `postgres` and
# `redis` for `localhost`.

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- database (one Postgres for everything) --------------------------------
DB_BACKEND=local
DATABASE_URL=postgresql+psycopg://daastaan:daastaan@postgres:5432/daastaan
DB_ECHO=false

# Set DB_BACKEND=lakebase to point at Databricks instead. Tokens are minted per
# connection, so no password goes here.
# LAKEBASE_HOST=instance-xxxx.database.cloud.databricks.com
# LAKEBASE_USER=you@example.com
# LAKEBASE_DATABASE=databricks_postgres
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>

# --- broker (one Redis for everything) -------------------------------------
REDIS_URL=redis://redis:6379/0

# --- object storage --------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=/data/media
# STORAGE_BACKEND=uc_volume
# UC_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
MODEL_REASONING=gpt-4o
MODEL_LIGHT=gpt-4o-mini
MODEL_TTS=gpt-4o-mini-tts
MODEL_IMAGE=gpt-image-1
MODEL_MODERATION=omni-moderation-latest

# --- auth ------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails if this is left at the development default and APP_ENV is not local.
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_TTL_SECONDS=43200
COOKIE_NAME=daastaan_session
# Must be true anywhere served over HTTPS.
COOKIE_SECURE=false

# --- frontends -------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- Databricks (all optional; everything falls back to local) -------------
# DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

MLFLOW_ENABLED=false
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT=/Shared/daastaan

LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
