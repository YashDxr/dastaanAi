# Copy to .env and fill in. Never commit .env - it is gitignored.
#
# Hostnames below are the Docker Compose service names. If you run the API or a
# worker directly on your laptop instead of in Compose, swap service hostnames
# for `localhost` (see Makefile LOCAL_ENV).

APP_ENV=local
LOG_LEVEL=INFO
# Set true when using Grafana/Loki so request_id is a searchable JSON field.
LOG_JSON=false

# --- database --------------------------------------------------------------
# docker → Compose starts Postgres (`make up` enables the postgres profile)
# host   → use Postgres on your machine; do not start the Compose DB
POSTGRES_MODE=docker

DB_BACKEND=local
# Compose Postgres (POSTGRES_MODE=docker):
DATABASE_URL=postgresql+psycopg://daastaan:daastaan@postgres:5432/daastaan
# Host Postgres from containers (POSTGRES_MODE=host), example:
# DATABASE_URL=postgresql+psycopg://daastaan:daastaan@host.docker.internal:5432/daastaan
# Host Postgres when running Python on the host (make api / make worker):
# DATABASE_URL=postgresql+psycopg://daastaan:daastaan@localhost:5432/daastaan
DB_ECHO=false

# Set DB_BACKEND=lakebase to point at Databricks instead. Tokens are minted per
# connection, so no password goes here.
# LAKEBASE_HOST=instance-xxxx.database.cloud.databricks.com
# LAKEBASE_USER=you@example.com
# LAKEBASE_DATABASE=databricks_postgres
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>

# --- broker (one Redis for everything) -------------------------------------
REDIS_URL=redis://redis:6379/0

# --- response cache --------------------------------------------------------
# Caches every paid model call by a hash of its full input, globally across
# users and stories. A hit is only ever served to a byte-identical request, and
# regenerations always bypass it so a respeak cannot return the take it is
# replacing. Set false while tuning prompts if you want every run to be fresh.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1209600
# Logical Redis database for the cache, derived from REDIS_URL's host. Kept off
# db 0 so Celery's task-result keys do not bury cache entries in Redis Insight.
CACHE_DB=1

# --- web origin ------------------------------------------------------------
# Where the browser app is served. Share links minted by the video editor are
# built from this rather than from the incoming request, so a link created
# through a proxy or a tunnel still points somewhere a recipient can reach.
WEB_BASE_URL=http://localhost:5173

# --- object storage --------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=/data/media
# STORAGE_BACKEND=uc_volume
# UC_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
MODEL_REASONING=gpt-4o
MODEL_LIGHT=gpt-4o-mini
MODEL_TTS=gpt-4o-mini-tts
MODEL_IMAGE=gpt-image-1
MODEL_MODERATION=omni-moderation-latest

# --- Sarvam (optional — Hindi and Indian-language TTS) --------------------
# When set and language is Hindi (or another Sarvam-supported language), the
# TTS stage uses Sarvam's bulbul:v3 instead of OpenAI for native-quality voices.
# SARVAM_API_KEY=your-sarvam-api-key

# --- local Apple-Silicon music sidecar ------------------------------------
# The service runs natively on the Mac so MLX can access Metal.  Docker workers
# reach it through host.docker.internal; for a different Mac/laptop use its
# private Tailscale HTTPS URL instead.
MUSIC_ENABLED=false
# Only worker-music sets this true. It receives credentials from .env.music,
# which is intentionally not shared with API, agent, TTS, image, or assembly.
MUSIC_CLIENT_ENABLED=false
MUSIC_SERVICE_BASE_URL=http://host.docker.internal:8787
# Credentials belong in .env.music (copy .env.music.example). Do not put them
# in this shared Compose environment file.
MUSIC_SERVICE_TIMEOUT_SECONDS=600
MUSIC_SERVICE_POLL_INTERVAL_SECONDS=2
MUSIC_DURATION_SECONDS=30

# --- auth ------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails if this is left at the development default and APP_ENV is not local.
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_TTL_SECONDS=43200
COOKIE_NAME=daastaan_session
# Must be true anywhere served over HTTPS.
COOKIE_SECURE=false

# --- frontends -------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- Databricks (all optional; everything falls back to local) -------------
# DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

MLFLOW_ENABLED=false
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT=/Shared/daastaan

LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
